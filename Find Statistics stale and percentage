-- Statistics stale and %

-- Step 1: List of tables you want to check
DECLARE @Tables TABLE (
    SchemaName SYSNAME,
    TableName SYSNAME
);

-- Step 2: Add your tables here
INSERT INTO @Tables (SchemaName, TableName)
VALUES 
    ('dbo', 'Customers'),
    ('dbo', 'Orders'),
    ('sales', 'Invoices'); -- Add more as needed

-- Step 3: Query statistics, row count, sample %, modification %
SELECT  
    t.SchemaName,
    t.TableName,
    s.name AS StatsName,
    s.auto_created,
    s.user_created,
    s.no_recompute,
    STATS_DATE(s.object_id, s.stats_id) AS LastUpdated,
    sp.rows AS StatsRows,
    ps.row_count AS TableRowCount,
    sp.modification_counter,
    
    -- Sample Percentage (if sp.rows is available)
    CASE 
        WHEN sp.rows IS NULL OR ps.row_count = 0 THEN NULL
        ELSE ROUND(100.0 * sp.rows / NULLIF(ps.row_count, 0), 2)
    END AS SamplePercentage,

    -- Modification Percentage
    CASE 
        WHEN sp.modification_counter IS NULL OR ps.row_count = 0 THEN NULL
        ELSE ROUND(100.0 * sp.modification_counter / NULLIF(ps.row_count, 0), 2)
    END AS ModificationPercentage,

    -- Optional recommendation
    CASE 
        WHEN sp.modification_counter IS NULL THEN 'Unknown'
        WHEN sp.modification_counter > 500 THEN 'Consider UPDATE STATISTICS'
        ELSE 'OK'
    END AS Recommendation

FROM @Tables t
JOIN sys.objects o 
    ON o.name = t.TableName AND SCHEMA_NAME(o.schema_id) = t.SchemaName
JOIN sys.stats s 
    ON s.object_id = o.object_id
CROSS APPLY sys.dm_db_stats_properties(s.object_id, s.stats_id) AS sp
JOIN (
    SELECT object_id, SUM(row_count) AS row_count
    FROM sys.dm_db_partition_stats
    WHERE index_id IN (0, 1)  -- 0 = heap, 1 = clustered index
    GROUP BY object_id
) ps ON ps.object_id = s.object_id
ORDER BY 
    t.SchemaName, t.TableName, s.name;

-- Statistics stale for all the tables for a DB
SELECT  
    SCHEMA_NAME(o.schema_id) AS SchemaName,
    o.name AS TableName,
    s.name AS StatsName,
    s.stats_id,
    s.auto_created,
    s.user_created,
    s.no_recompute,
    STATS_DATE(s.object_id, s.stats_id) AS LastUpdated,
    sp.rows AS StatsRows,
    ps.TotalRows AS TableRowCount,
    sp.modification_counter,
    
    -- Sample Percentage (rows in stat vs total rows)
    CASE 
        WHEN sp.rows IS NULL OR ps.TotalRows = 0 THEN NULL
        ELSE ROUND(100.0 * sp.rows / NULLIF(ps.TotalRows, 0), 2)
    END AS SamplePercentage,

    -- Modification Percentage (changes since last stat update)
    CASE 
        WHEN sp.modification_counter IS NULL OR ps.TotalRows = 0 THEN NULL
        ELSE ROUND(100.0 * sp.modification_counter / NULLIF(ps.TotalRows, 0), 2)
    END AS ModificationPercentage

FROM sys.stats s
JOIN sys.objects o ON s.object_id = o.object_id
LEFT JOIN sys.dm_db_stats_properties(s.object_id, s.stats_id) AS sp ON 1 = 1
LEFT JOIN (
    SELECT object_id, SUM(row_count) AS TotalRows
    FROM sys.dm_db_partition_stats
    WHERE index_id IN (0, 1)  -- clustered or heap
    GROUP BY object_id
) ps ON s.object_id = ps.object_id
WHERE o.type = 'U'  -- Only user tables
ORDER BY ps.TotalRows DESC, TableName, StatsName;
