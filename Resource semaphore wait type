SUM(CASE WHEN status = 'VISIBLE ONLINE' THEN 1 ELSE 0 END) AS visible_online_schedulers    FROM sys.dm_os_schedulers    
WHERE scheduler_id < 1048576  -- Filter out the DAC scheduler),Numa_Info AS (    SELECT         COUNT(DISTINCT parent_node_id) AS numa_node_count    FROM sys.dm_os_schedulers    WHERE status = 'VISIBLE ONLINE' AND scheduler_id < 1048576),CPU_Recommendation AS (    SELECT         v.visible_online_schedulers AS total_cores,        n.numa_node_count AS numa_nodes,        CASE             WHEN v.visible_online_schedulers <= 8 THEN v.visible_online_schedulers            WHEN v.visible_online_schedulers <= 32 THEN 8            WHEN v.visible_online_schedulers > 32 THEN 16        END AS recommended_maxdop    FROM CPU_Info v    CROSS JOIN Numa_Info n)SELECT     total_cores,    numa_nodes,    recommended_maxdop,    'USE: EXEC sp_configure ''max degree of parallelism'', ' +         CAST(recommended_maxdop AS VARCHAR(10)) + '; RECONFIGURE;' AS recommendation_scriptFROM CPU_Recommendation;

