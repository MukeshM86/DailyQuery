WITH ParallelPlans AS (    SELECT         qs.plan_handle,        qs.execution_count,        qs.total_worker_time,        qs.total_elapsed_time,        qs.total_logical_reads,        qs.creation_time,        qp.query_plan,        cp.usecounts,        cp.size_in_bytes,        p.n.value('(//RelOp/@Parallel)[1]', 'varchar(5)') AS is_parallel,        p.n.value('(//StmtSimple/@StatementSubTreeCost)[1]', 'float') AS estimated_cost    FROM sys.dm_exec_query_stats qs    CROSS APPLY sys.dm_exec_text_query_plan(qs.plan_handle, DEFAULT, DEFAULT) AS qp    JOIN sys.dm_exec_cached_plans cp ON qs.plan_handle = cp.plan_handle    CROSS APPLY qp.query_plan.nodes('//BatchSequence/Batch/Statements/StmtSimple') AS p(n)    WHERE cp.cacheobjtype = 'Compiled Plan')SELECT     COUNT(*) AS total_parallel_plans,    MIN(estimated_cost) AS min_parallel_cost,    MAX(estimated_cost) AS max_parallel_cost,    AVG(estimated_cost) AS avg_parallel_cost,    PERCENTILE_CONT(0.25) WITHIN GROUP (ORDER BY estimated_cost) OVER () AS p25_cost,    PERCENTILE_CONT(0.50) WITHIN GROUP (ORDER BY estimated_cost) OVER () AS p50_cost,    PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY estimated_cost) OVER () AS p75_cost,    PERCENTILE_CONT(0.90) WITHIN GROUP (ORDER BY estimated_cost) OVER () AS p90_costFROM ParallelPlansWHERE is_parallel = '1';-- Analyze cached plans for parallelism and their estimated costWITH ParallelPlans AS (    SELECT         qs.plan_handle,        qs.execution_count,        qs.total_worker_time,        qs.total_elapsed_time,        qs.total_logical_reads,        qs.creation_time,        qp.query_plan,        cp.usecounts,        cp.size_in_bytes,        p.n.value('(//RelOp/@Parallel)[1]', 'varchar(5)') AS is_parallel,        p.n.value('(//StmtSimple/@StatementSubTreeCost)[1]', 'float') AS estimated_cost    FROM sys.dm_exec_query_stats qs    CROSS APPLY sys.dm_exec_text_query_plan(qs.plan_handle, DEFAULT, DEFAULT) AS qp    JOIN sys.dm_exec_cached_plans cp ON qs.plan_handle = cp.plan_handle    CROSS APPLY qp.query_plan.nodes('//BatchSequence/Batch/Statements/StmtSimple') AS p(n)    WHERE cp.cacheobjtype = 'Compiled Plan')SELECT     COUNT(*) AS total_parallel_plans,    MIN(estimated_cost) AS min_parallel_cost,    MAX(estimated_cost) AS max_parallel_cost,    AVG(estimated_cost) AS avg_parallel_cost,    PERCENTILE_CONT(0.25) WITHIN GROUP (ORDER BY estimated_cost) OVER () AS p25_cost,    PERCENTILE_CONT(0.50) WITHIN GROUP (ORDER BY estimated_cost) OVER () AS p50_cost,    PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY estimated_cost) OVER () AS p75_cost,    PERCENTILE_CONT(0.90) WITHIN GROUP (ORDER BY estimated_cost) OVER () AS p90_costFROM ParallelPlansWHERE is_parallel = '1';
